{
  "name": "@adsesugh/monnify-nodejs-sdk",
  "version": "1.0.0",
  "description": "Monnify Payment Gateway SDK — Accept payments directly on your website via cards, bank transfers or USSD from customers. Integrate multiple payment options on your website or app & increase your conversion rate.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "release": "release-it --only-version",
    "prepublishOnly": "npm run build",
    "example": "ts-node examples/basic-usage.ts",
    "webhook": "ts-node examples/webhook-handler.ts"
  },
  "keywords": [
    "monnify",
    "payment",
    "gateway",
    "nigeria",
    "fintech",
    "sdk"
  ],
  "author": "Sesugh Agbadu",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "dotenv": "^16.0.0",
    "eslint": "^8.0.0",
    "express": "^4.18.0",
    "jest": "^29.0.0",
    "nock": "^13.0.0",
    "release-it": "^17.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adsesugh/monnify-nodejs-sdk.git"
  }
}
